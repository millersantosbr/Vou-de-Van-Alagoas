rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Por padrão, bloqueia qualquer leitura ou escrita não explicitamente autorizada
    match /{document=**} {
      allow read, write: if false;
    }

    // Coleção pública de consulta de linhas de vans (somente leitura pública, sem escrita pelo client)
    match /linhas/{linhaId} {
      allow read: if true;
      allow write: if false;
    }

    // Coleção de pontos e terminais (somente leitura pública, sem escrita pelo client)
    match /pontos/{pontoId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
